          "required": true
        },
        {
          "code": "RL12",
          "kind": "radio",
          "question": "Do you already have a script or talking points?",
          "options": [
            { "label": "Final Script Ready", "value": "final_script_ready" },
            { "label": "Rough Ideas", "value": "rough_ideas" },
            { "label": "Need Copywriting Support", "value": "need_copywriting_support" },
            { "label": "No Voiceover Required", "value": "no_voiceover_required" }
