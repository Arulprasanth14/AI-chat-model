{
  "key": "startup_entrepreneur_press_kit",
  "label": "Press Kit",
  "verticalKey": "startup",
  "templateNameMatch": ["press kit", "media kit", "press release kit"],
  "sections": [
    {
      "name": "Press Kit Overview",
      "questions": [
        {
          "code": "PK1",
          "kind": "radio",
          "question": "What is this press kit for?",
          "hint": "Press kits should communicate one clear story.",
          "options": [
            { "label": "Startup Launch", "value": "startup_launch" },
            { "label": "Product Launch", "value": "product_launch" },
            { "label": "Funding Announcement", "value": "funding_announcement" },
            { "label": "Company Milestone", "value": "company_milestone" },
            { "label": "Partnership Announcement", "value": "partnership_announcement" },
            { "label": "Event Announcement", "value": "event_announcement" },
            { "label": "General Media Kit", "value": "general_media_kit" }
          ],
          "required": true
        },
        {
          "code": "PK2",
          "kind": "text",
          "question": "What company, product, or announcement are we featuring?",
          "hint": "Provide a brief summary of the news or story.",
          "required": true
        },
        {
          "code": "PK3",
          "kind": "checkbox",
          "question": "Who is the target audience for this press kit?",
          "hint": "Different audiences require different messaging.",
          "options": [
            { "label": "Journalists", "value": "journalists" },
            { "label": "Industry Publications", "value": "industry_publications" },
            { "label": "Investors", "value": "investors" },
            { "label": "Partners", "value": "partners" },
            { "label": "Influencers", "value": "influencers" },
            { "label": "Event Organisers", "value": "event_organisers" },
            { "label": "Other", "value": "other" }
          ],
          "required": true
