          "hint": "Select all required sections. Multi-select.",
          "options": [
            { "label": "Company Overview", "value": "company_overview" },
            { "label": "Founder Biography", "value": "founder_biography" },
            { "label": "Leadership Team", "value": "leadership_team" },
            { "label": "Product Overview", "value": "product_overview" },
            { "label": "Funding Information", "value": "funding_information" },
            { "label": "Company Timeline", "value": "company_timeline" },
            { "label": "Key Statistics", "value": "key_statistics" },
            { "label": "Awards & Recognition", "value": "awards_recognition" },
            { "label": "Partnerships", "value": "partnerships" },
            { "label": "Media Coverage", "value": "media_coverage" },
            { "label": "FAQs", "value": "faqs" },
            { "label": "Press Release", "value": "press_release" },
            { "label": "Contact Information", "value": "contact_information" }
          ],
          "required": true
        },
        {
          "code": "PK5",
          "kind": "checkbox",
          "question": "What key facts, statistics, or milestones should be highlighted?",
          "hint": "Journalists often use these directly in articles.",
          "options": [
            { "label": "Funding Raised", "value": "funding_raised" },
            { "label": "Customers", "value": "customers" },
            { "label": "Users", "value": "users" },
            { "label": "Revenue Milestones", "value": "revenue_milestones" },
            { "label": "Growth Metrics", "value": "growth_metrics" },
            { "label": "Geographic Reach", "value": "geographic_reach" },
            { "label": "Team Size", "value": "team_size" },
            { "label": "Other", "value": "other" }
          ],
          "required": true
        }
      ]
    },
    {
      "name": "Media Assets",
      "questions": [
        {
          "code": "PK6",
          "kind": "radio",
          "question": "Do you have photography or imagery?",
          "hint": "High-quality media assets are essential.",
          "options": [
            { "label": "Yes", "value": "yes" },
            { "label": "No", "value": "no" }
          ],
          "required": true
        },
        {
          "code": "PK7",
          "kind": "file",
          "question": "Upload logos, founder photos, executive headshots, team photos, screenshots, and product images.",
          "hint": "High-resolution files preferred. Only if you have photography or imagery.",
          "required": false
        }
      ]
    },
    {
      "name": "Company & People",
      "questions": [
        {
          "code": "PK8",
          "kind": "text",
          "question": "What company information should appear?",
          "hint": "Provide an approved company description or boilerplate.",
          "required": true
        },
        {
          "code": "PK9",
          "kind": "radio",
          "question": "Should founder or executive profiles be included?",
          "options": [
            { "label": "Founder Only", "value": "founder_only" },
            { "label": "Leadership Team", "value": "leadership_team" },
            { "label": "No Profiles Required", "value": "no_profiles_required" }
          ],
          "required": true
        },
        {
          "code": "PK10",
          "kind": "text",
          "question": "Provide founder/executive biographies and titles.",
          "hint": "Only if you selected Founder Only or Leadership Team above.",
          "required": false
        }
      ]
    },
    {
      "name": "Quotes & Contact",
      "questions": [
        {
          "code": "PK11",
