          "question": "Are there approved quotes that media can use?",
          "options": [
            { "label": "Yes", "value": "yes" },
            { "label": "No", "value": "no" }
          ],
          "required": true
        },
        {
          "code": "PK12",
          "kind": "text",
          "question": "Provide approved spokesperson quotes.",
          "hint": "Examples: Founder quote, CEO statement, Investor quote, Customer quote. Only if you said yes above.",
          "required": false
        },
        {
          "code": "PK13",
          "kind": "checkbox",
          "question": "What contact information should media use?",
          "hint": "Ensure journalists can quickly reach the correct person.",
          "options": [
            { "label": "PR Contact", "value": "pr_contact" },
            { "label": "Founder", "value": "founder" },
            { "label": "Marketing Team", "value": "marketing_team" },
            { "label": "Agency Representative", "value": "agency_representative" },
            { "label": "Other", "value": "other" }
          ],
          "required": true
        }
      ]
    },
    {
      "name": "Media Coverage & Distribution",
      "questions": [
        {
          "code": "PK14",
          "kind": "radio",
          "question": "Has the company received any notable media coverage, awards, or recognition?",
          "options": [
            { "label": "Yes", "value": "yes" },
            { "label": "No", "value": "no" }
          ],
          "required": true
        },
        {
          "code": "PK15",
          "kind": "text",
          "question": "Provide links, publications, awards, or recognition details.",
          "hint": "Only if you said yes above.",
          "required": false
        },
        {
          "code": "PK16",
          "kind": "radio",
          "question": "Will media assets need to be downloadable separately?",
          "hint": "This affects how the press kit is structured.",
          "options": [
            { "label": "Yes", "value": "yes" },
            { "label": "No", "value": "no" }
          ],
          "required": true
        }
      ]
    },
    {
      "name": "Timing",
      "questions": [
        {
          "code": "PK17",
          "kind": "radio",
          "question": "Is there an announcement date or embargo?",
          "hint": "Important for media scheduling.",
          "options": [
            { "label": "Immediate Release", "value": "immediate_release" },
            { "label": "Scheduled Release Date", "value": "scheduled_release_date" },
            { "label": "Embargoed Announcement", "value": "embargoed_announcement" }
          ],
          "required": true
        },
        {
          "code": "PK18",
          "kind": "text",
          "question": "Provide announcement date and time.",
          "hint": "Only if you selected Scheduled Release Date or Embargoed Announcement above.",
          "required": false
        }
      ]
    },
    {
      "name": "Style & References",
      "questions": [
        {
          "code": "PK19",
          "kind": "radio",
          "question": "Any reference press kits or media kits you'd like us to reference?",
          "hint": "Share examples you admire.",
          "options": [
            { "label": "Yes", "value": "yes" },
            { "label": "No", "value": "no" }
          ],
          "required": true
        },
        {
          "code": "PK20",
          "kind": "file",
          "question": "Upload reference press kits, up to 3.",
          "hint": "Only if you said yes to reference press kits above.",
          "required": false
        },
        {
          "code": "PK21",
          "kind": "radio",
          "question": "Describe the visual style you'd like.",
          "options": [
            { "label": "Startup", "value": "startup" },
            { "label": "Corporate", "value": "corporate" },
            { "label": "Investor-Grade", "value": "investor_grade" },
            { "label": "Minimal", "value": "minimal" },
            { "label": "Premium", "value": "premium" },
            { "label": "Technology-Focused", "value": "technology_focused" },
            { "label": "Other", "value": "other" }
          ],
          "required": true
        },
        {
          "code": "PK22",
          "kind": "checkbox",
          "question": "Any technical requirements?",
          "hint": "Leave blank if unsure.",
          "options": [
            { "label": "PDF Only", "value": "pdf_only" },
            { "label": "Print-Ready", "value": "print_ready" },
            { "label": "Interactive PDF", "value": "interactive_pdf" },
            { "label": "Press Download Folder", "value": "press_download_folder" },
            { "label": "Editable Source Files", "value": "editable_source_files" },
            { "label": "Other", "value": "other" }
          ],
          "required": false
        }
      ]
