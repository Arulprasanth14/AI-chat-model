        {
          "code": "RL10",
          "kind": "text",
          "question": "Are there any moments that must appear?",
          "hint": "Examples: Store entrance, Product close-ups, Staff interaction, Customer shopping, Collection reveal, Offer announcement, Checkout experience.",
