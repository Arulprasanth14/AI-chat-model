          "required": true
        },
        {
          "code": "RL7",
          "kind": "text",
          "question": "Provide the offer details, start & end date, and terms & conditions.",
          "hint": "Only if you are running an offer.",
          "required": false
        }
      ]
    },
    {
      "name": "Footage & Key Shots",
      "questions": [
        {
          "code": "RL8",
          "kind": "checkbox",
