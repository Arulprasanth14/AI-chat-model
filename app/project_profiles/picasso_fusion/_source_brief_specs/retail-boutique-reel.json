{
  "key": "retail_boutique_reel",
  "label": "Reel",
  "verticalKey": "retail",
  "templateNameMatch": ["reel", "reels", "reel creative brief"],
  "sections": [
    {
      "name": "Reel Purpose & Product",
      "questions": [
        {
          "code": "RL1",
          "kind": "radio",
          "question": "What are we creating today?",
          "hint": "Select the purpose of this reel.",
          "options": [
            { "label": "New Collection Launch", "value": "new_collection_launch" },
            { "label": "New Arrivals", "value": "new_arrivals" },
            { "label": "Product Showcase", "value": "product_showcase" },
            { "label": "Store Tour", "value": "store_tour" },
            { "label": "Seasonal Campaign", "value": "seasonal_campaign" },
            { "label": "Sale / Offer", "value": "sale_offer" },
            { "label": "Styling Tips", "value": "styling_tips" },
            { "label": "Behind the Scenes", "value": "behind_the_scenes" },
            { "label": "Customer Experience", "value": "customer_experience" },
            { "label": "Event Promotion", "value": "event_promotion" },
            { "label": "Brand Story", "value": "brand_story" },
            { "label": "Other", "value": "other" }
