          "required": true
        },
        {
          "code": "RL2",
          "kind": "text",
          "question": "What are we featuring?",
          "hint": "Provide the key details: Product/Collection/Event Name, Category, Key Features/Benefits, Price (Optional).",
          "required": true
        },
        {
          "code": "RL3",
          "kind": "text",
          "question": "What's the ONE message customers should remember?",
          "hint": "Describe the biggest reason someone should watch and visit your store. Example: \"Our summer collection has arrived.\", \"Visit us for exclusive in-store offers.\", \"See how we style this season's best looks.\"",
          "required": true
        }
      ]
    },
    {
      "name": "Goal & Audience",
      "questions": [
        {
          "code": "RL4",
          "kind": "checkbox",
          "question": "What's the goal of this reel?",
          "options": [
            { "label": "Increase Store Visits", "value": "increase_store_visits" },
            { "label": "Promote a Collection", "value": "promote_a_collection" },
            { "label": "Showcase Products", "value": "showcase_products" },
            { "label": "Build Brand Awareness", "value": "build_brand_awareness" },
            { "label": "Promote an Offer", "value": "promote_an_offer" },
            { "label": "Generate Enquiries", "value": "generate_enquiries" },
            { "label": "Highlight Store Experience", "value": "highlight_store_experience" },
            { "label": "Event Promotion", "value": "event_promotion" },
            { "label": "Other", "value": "other" }
          ],
          "required": true
        },
        {
          "code": "RL5",
          "kind": "text",
          "question": "Who is this reel for?",
          "hint": "Describe your ideal customer.",
          "required": true
        }
      ]
    },
    {
      "name": "Offer",
      "questions": [
        {
          "code": "RL6",
          "kind": "radio",
          "question": "Are you running an offer?",
          "options": [
            { "label": "No Offer", "value": "no_offer" },
            { "label": "Percentage Discount", "value": "percentage_discount" },
            { "label": "Flat Discount", "value": "flat_discount" },
            { "label": "Buy One Get One", "value": "buy_one_get_one" },
            { "label": "Free Gift", "value": "free_gift" },
            { "label": "Limited-Time Offer", "value": "limited_time_offer" },
            { "label": "Other", "value": "other" }
