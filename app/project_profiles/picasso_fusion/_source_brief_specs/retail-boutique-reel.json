          "required": true
        },
        {
          "code": "RL9",
          "kind": "file",
          "question": "Upload your files.",
          "hint": "Upload videos, photos, logos, or supporting assets. Recommended: MP4/MOV, Vertical (9:16) preferred, 1080p or higher.",
