          "hint": "Choose a style that matches your brand.",
          "options": [
            { "label": "Corporate", "value": "corporate" },
            { "label": "Minimal", "value": "minimal" },
            { "label": "Modern", "value": "modern" },
            { "label": "Premium", "value": "premium" },
            { "label": "Startup", "value": "startup" },
            { "label": "Creative", "value": "creative" },
            { "label": "Sales-Focused", "value": "sales_focused" }
          ],
          "required": true
        },
        {
          "code": "ES10",
          "kind": "radio",
          "question": "Will employee headshots be included?",
          "options": [
            { "label": "Yes", "value": "yes" },
            { "label": "No", "value": "no" },
            { "label": "Optional", "value": "optional" }
          ],
          "required": true
        }
      ]
    },
    {
      "name": "Legal & Compliance",
      "questions": [
        {
          "code": "ES11",
          "kind": "radio",
          "question": "Should a legal disclaimer or compliance notice be included?",
          "options": [
            { "label": "Yes", "value": "yes" },
            { "label": "No", "value": "no" }
          ],
          "required": true
        },
        {
          "code": "ES12",
          "kind": "text",
          "question": "Provide disclaimer text.",
          "hint": "Only if you said yes above.",
          "required": false
        }
      ]
    },
    {
      "name": "Platform & Technical",
      "questions": [
        {
          "code": "ES13",
          "kind": "checkbox",
          "question": "Which email platform(s) will use this signature?",
          "hint": "Rendering differs between platforms.",
          "options": [
            { "label": "Outlook", "value": "outlook" },
            { "label": "Gmail", "value": "gmail" },
            { "label": "Microsoft 365", "value": "microsoft_365" },
            { "label": "Apple Mail", "value": "apple_mail" },
            { "label": "Thunderbird", "value": "thunderbird" },
            { "label": "Multiple Platforms", "value": "multiple_platforms" }
          ],
          "required": true
        },
        {
          "code": "ES14",
          "kind": "radio",
          "question": "Do you need HTML email signature files or design-only output?",
          "hint": "This is probably the most important technical question and is currently missing.",
          "options": [
            { "label": "HTML Signature", "value": "html_signature" },
            { "label": "Design Mockup Only", "value": "design_mockup_only" },
            { "label": "Both", "value": "both" },
            { "label": "Not Sure", "value": "not_sure" }
          ],
          "required": true
        }
      ]
    },
    {
      "name": "References",
      "questions": [
        {
          "code": "ES15",
          "kind": "radio",
          "question": "Any reference signatures or inspiration?",
          "options": [
            { "label": "Yes", "value": "yes" },
            { "label": "No", "value": "no" }
          ],
          "required": true
        },
        {
          "code": "ES16",
          "kind": "file",
          "question": "Upload reference signatures, up to 3.",
          "hint": "Only if you said yes to reference signatures above.",
