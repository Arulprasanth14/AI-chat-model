          "required": true
        },
        {
          "code": "ES8",
          "kind": "file",
          "question": "Upload logo and brand assets.",
          "hint": "SVG or PNG preferred. Only if you have brand assets.",
          "required": false
        }
      ]
    },
    {
      "name": "Style & People",
      "questions": [
        {
          "code": "ES9",
          "kind": "radio",
