{
  "key": "ecommerce_carousel",
  "label": "Carousel",
  "verticalKey": "ecommerce",
  "templateNameMatch": ["carousel set", "carousel", "carousel post"],
  "sections": [
    {
      "name": "Carousel Purpose & Product",
      "questions": [
        {
          "code": "CR1",
          "kind": "radio",
          "question": "What are we creating today?",
          "hint": "Select the purpose of this carousel.",
          "options": [
            { "label": "Product Launch", "value": "product_launch" },
            { "label": "Product Showcase", "value": "product_showcase" },
            { "label": "Collection Showcase", "value": "collection_showcase" },
            { "label": "New Arrivals", "value": "new_arrivals" },
            { "label": "Best Sellers", "value": "best_sellers" },
            { "label": "Product Features", "value": "product_features" },
            { "label": "Product Comparison", "value": "product_comparison" },
            { "label": "How to Use", "value": "how_to_use" },
            { "label": "Before & After", "value": "before_after" },
            { "label": "Customer Reviews", "value": "customer_reviews" },
            { "label": "Offer / Sale", "value": "offer_sale" },
            { "label": "Seasonal Campaign", "value": "seasonal_campaign" },
            { "label": "Gift Guide", "value": "gift_guide" },
            { "label": "Other", "value": "other" }
          ],
          "required": true
        },
        {
          "code": "CR2",
          "kind": "text",
          "question": "Which product(s) are we featuring?",
          "hint": "Provide the key product information: Product Name(s), Category, Price (Optional), Key Features/Benefits, Colours/Sizes/Variants (Optional).",
          "required": true
        },
        {
          "code": "CR3",
          "kind": "text",
          "question": "What's the ONE message customers should remember?",
          "hint": "Describe the biggest reason someone should buy these products. Example: \"Designed for all-day comfort.\", \"Premium quality at an everyday price.\", \"The perfect gift for every occasion.\"",
          "required": true
        }
      ]
    },
    {
      "name": "Goal & Audience",
      "questions": [
        {
          "code": "CR4",
          "kind": "checkbox",
          "question": "What's the goal of this carousel?",
          "options": [
            { "label": "Increase Sales", "value": "increase_sales" },
            { "label": "Promote a Collection", "value": "promote_a_collection" },
            { "label": "Launch a Product", "value": "launch_a_product" },
            { "label": "Highlight Features", "value": "highlight_features" },
            { "label": "Educate Customers", "value": "educate_customers" },
            { "label": "Drive Website Traffic", "value": "drive_website_traffic" },
            { "label": "Build Brand Awareness", "value": "build_brand_awareness" },
            { "label": "Promote an Offer", "value": "promote_an_offer" },
            { "label": "Other", "value": "other" }
          ],
          "required": true
        },
        {
          "code": "CR5",
          "kind": "text",
          "question": "Who is this carousel for?",
          "hint": "Describe your ideal customer.",
          "required": true
        }
      ]
    },
    {
      "name": "Structure & Content",
      "questions": [
        {
          "code": "CR6",
          "kind": "radio",
          "question": "How should the carousel be structured?",
          "hint": "Choose the storytelling style.",
          "options": [
            { "label": "Product Features", "value": "product_features" },
            { "label": "Product Comparison", "value": "product_comparison" },
            { "label": "Collection Showcase", "value": "collection_showcase" },
            { "label": "Problem → Solution", "value": "problem_solution" },
            { "label": "Before → After", "value": "before_after" },
            { "label": "How to Use", "value": "how_to_use" },
            { "label": "Customer Journey", "value": "customer_journey" },
            { "label": "Gift Guide", "value": "gift_guide" },
            { "label": "Designer Can Recommend", "value": "designer_can_recommend" }
          ],
          "required": true
        },
        {
          "code": "CR7",
          "kind": "radio",
          "question": "Do you already have the content?",
          "options": [
            { "label": "Final Copy Ready", "value": "final_copy_ready" },
            { "label": "Rough Points", "value": "rough_points" },
            { "label": "Need Copywriting Support", "value": "need_copywriting_support" }
          ],
          "required": true
        },
        {
          "code": "CR8",
          "kind": "text",
          "question": "Provide your copy or rough points.",
          "hint": "Only if you have final copy ready or rough points.",
          "required": false
        },
        {
          "code": "CR9",
          "kind": "text",
          "question": "Tell us the flow of the carousel.",
          "hint": "Describe what you'd like each slide to communicate. Example: Cover → New Summer Collection; Slide 2 → Product 1; Slide 3 → Product 2; Slide 4 → Key Benefits; Slide 5 → Customer Review; Slide 6 → Offer; Slide 7 → Shop Now.",
          "required": true
        },
        {
          "code": "CR10",
          "kind": "text",
          "question": "What should the cover slide say?",
          "hint": "This is the first thing customers will see. Example: \"Meet Our New Collection\", \"5 Products You'll Love\", \"Upgrade Your Everyday Essentials\".",
          "required": true
        },
        {
          "code": "CR11",
          "kind": "radio",
          "question": "How many slides would you like?",
          "options": [
            { "label": "5", "value": "5" },
            { "label": "6", "value": "6" },
            { "label": "7", "value": "7" },
            { "label": "Let the Creative Team Decide", "value": "let_the_creative_team_decide" }
          ],
          "required": true
        }
      ]
    },
    {
      "name": "Offer",
      "questions": [
        {
          "code": "CR12",
          "kind": "radio",
          "question": "Are you running an offer?",
          "options": [
            { "label": "No Offer", "value": "no_offer" },
            { "label": "Discount", "value": "discount" },
            { "label": "Buy One Get One", "value": "buy_one_get_one" },
            { "label": "Bundle Offer", "value": "bundle_offer" },
            { "label": "Free Shipping", "value": "free_shipping" },
            { "label": "Limited-Time Offer", "value": "limited_time_offer" },
            { "label": "Other", "value": "other" }
