          "required": true
        },
        {
          "code": "CR10",
          "kind": "text",
          "question": "What should the cover slide say?",
          "hint": "This is the first thing customers will see. Example: \"New Collection Has Arrived\", \"7 Must-Have Home Décor Pieces\", \"Why Everyone Loves Our Boutique\".",
