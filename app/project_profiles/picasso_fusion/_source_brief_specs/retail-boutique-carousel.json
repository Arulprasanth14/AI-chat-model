        {
          "code": "CR1",
          "kind": "radio",
          "question": "What are we creating today?",
          "hint": "Select the purpose of this carousel.",
          "options": [
            { "label": "New Collection Launch", "value": "new_collection_launch" },
            { "label": "Product Showcase", "value": "product_showcase" },
            { "label": "Seasonal Collection", "value": "seasonal_collection" },
            { "label": "Best Sellers", "value": "best_sellers" },
            { "label": "New Arrivals", "value": "new_arrivals" },
            { "label": "Gift Guide", "value": "gift_guide" },
            { "label": "Product Comparison", "value": "product_comparison" },
            { "label": "How to Choose", "value": "how_to_choose" },
            { "label": "Styling Tips", "value": "styling_tips" },
            { "label": "Behind the Brand", "value": "behind_the_brand" },
            { "label": "Customer Stories", "value": "customer_stories" },
            { "label": "Store Tour", "value": "store_tour" },
            { "label": "Sale / Offer", "value": "sale_offer" },
            { "label": "Event Promotion", "value": "event_promotion" },
            { "label": "Other", "value": "other" }
