        {
          "code": "CR11",
          "kind": "radio",
          "question": "How many slides would you like?",
          "options": [
            { "label": "5", "value": "5" },
            { "label": "6", "value": "6" },
            { "label": "7", "value": "7" },
            { "label": "Let the Creative Team Decide", "value": "let_the_creative_team_decide" }
