          "required": true
        },
        {
          "code": "CR3",
          "kind": "text",
          "question": "What's the ONE message customers should remember?",
          "hint": "Describe the biggest reason someone should swipe through and visit your store or explore your collection. Example: \"Discover our latest summer collection.\", \"Find the perfect gift for every occasion.\", \"See why customers love our handcrafted furniture.\"",
          "required": true
        }
      ]
    },
    {
      "name": "Goal & Audience",
      "questions": [
        {
          "code": "CR4",
          "kind": "checkbox",
          "question": "What's the goal of this carousel?",
          "options": [
            { "label": "Increase Store Visits", "value": "increase_store_visits" },
            { "label": "Promote a Collection", "value": "promote_a_collection" },
            { "label": "Showcase Multiple Products", "value": "showcase_multiple_products" },
