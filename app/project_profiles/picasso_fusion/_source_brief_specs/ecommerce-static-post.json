    {
      "name": "Images & Assets",
      "questions": [
        {
          "code": "SP11",
          "kind": "checkbox",
          "question": "Do you have product photos?",
          "options": [
            { "label": "I'll Upload Product Photos", "value": "ill_upload_product_photos" },
            { "label": "I'll Upload Lifestyle Photos", "value": "ill_upload_lifestyle_photos" },
            { "label": "I'll Upload Both", "value": "ill_upload_both" },
            { "label": "Use Stock Lifestyle Images", "value": "use_stock_lifestyle_images" },
            { "label": "Use Only Brand Assets", "value": "use_only_brand_assets" },
            { "label": "Designer Can Suggest", "value": "designer_can_suggest" }
