        {
          "code": "SP14",
          "kind": "checkbox",
          "question": "What should we customize?",
          "hint": "Only if you selected \"Customize This Project\" above.",
          "options": [
            { "label": "Brand Colors", "value": "brand_colors" },
            { "label": "Brand Fonts", "value": "brand_fonts" },
            { "label": "Additional Instructions", "value": "additional_instructions" }
          ],
          "required": false
        },
        {
          "code": "SP15",
          "kind": "text",
          "question": "Provide any additional brand customization details.",
          "hint": "Only if you selected \"Customize This Project\" above.",
          "required": false
