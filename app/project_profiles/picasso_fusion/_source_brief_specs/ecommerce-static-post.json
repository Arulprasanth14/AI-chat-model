{
  "key": "ecommerce_static_post",
  "label": "Static Post",
  "verticalKey": "ecommerce",
  "templateNameMatch": ["static post", "static post set", "social media post", "post set"],
  "sections": [
    {
      "name": "Post Purpose & Product",
      "questions": [
        {
          "code": "SP1",
          "kind": "radio",
          "question": "What are we creating today?",
          "hint": "Select the purpose of this post.",
          "options": [
            { "label": "Product Launch", "value": "product_launch" },
            { "label": "Product Promotion", "value": "product_promotion" },
            { "label": "New Arrival", "value": "new_arrival" },
            { "label": "Best Seller", "value": "best_seller" },
            { "label": "Limited-Time Offer", "value": "limited_time_offer" },
            { "label": "Seasonal Campaign", "value": "seasonal_campaign" },
            { "label": "Collection Showcase", "value": "collection_showcase" },
            { "label": "Product Benefits", "value": "product_benefits" },
            { "label": "Customer Review", "value": "customer_review" },
            { "label": "Brand Awareness", "value": "brand_awareness" },
            { "label": "Other", "value": "other" }
          ],
          "required": true
        },
        {
          "code": "SP2",
          "kind": "text",
          "question": "Which product are we featuring?",
          "hint": "Provide the key product details: Product Name, Category, Price (Optional), Key Benefits/Features, Available Colours, Sizes or Variants (Optional).",
          "required": true
        },
        {
          "code": "SP3",
          "kind": "text",
          "question": "What's the one message customers should remember?",
          "hint": "Describe the biggest reason someone should buy this product. Example: \"Ultra-light running shoes designed for all-day comfort.\", \"Organic skincare made for sensitive skin.\"",
          "required": true
        }
      ]
    },
    {
      "name": "Goal & Audience",
      "questions": [
        {
          "code": "SP4",
          "kind": "checkbox",
          "question": "What's the goal of this post?",
          "options": [
            { "label": "Increase Sales", "value": "increase_sales" },
            { "label": "Drive Website Traffic", "value": "drive_website_traffic" },
            { "label": "Promote an Offer", "value": "promote_an_offer" },
            { "label": "Launch a New Product", "value": "launch_a_new_product" },
            { "label": "Build Brand Awareness", "value": "build_brand_awareness" },
            { "label": "Collect Enquiries", "value": "collect_enquiries" },
            { "label": "Grow Followers", "value": "grow_followers" },
            { "label": "Other", "value": "other" }
          ],
          "required": true
        },
        {
          "code": "SP5",
          "kind": "text",
          "question": "Who is this product for?",
          "hint": "Describe your ideal customer.",
          "required": true
        }
      ]
    },
    {
      "name": "Offer",
      "questions": [
        {
          "code": "SP6",
          "kind": "radio",
          "question": "Are you running an offer?",
          "options": [
            { "label": "No Offer", "value": "no_offer" },
            { "label": "Discount", "value": "discount" },
            { "label": "Buy One Get One", "value": "buy_one_get_one" },
            { "label": "Bundle Offer", "value": "bundle_offer" },
            { "label": "Free Shipping", "value": "free_shipping" },
            { "label": "Limited-Time Offer", "value": "limited_time_offer" },
            { "label": "Other", "value": "other" }
          ],
          "required": true
        },
        {
          "code": "SP7",
          "kind": "text",
          "question": "Provide the offer details, start & end date, and terms & conditions.",
          "hint": "Only if you are running an offer.",
          "required": false
        }
      ]
    },
    {
      "name": "Copy",
      "questions": [
        {
          "code": "SP8",
          "kind": "radio",
          "question": "Do you already have the copy?",
          "options": [
            { "label": "Final Copy Ready", "value": "final_copy_ready" },
            { "label": "Rough Points", "value": "rough_points" },
            { "label": "Need Copywriting Support", "value": "need_copywriting_support" }
          ],
          "required": true
        },
        {
          "code": "SP9",
          "kind": "text",
          "question": "Provide your copy or rough points.",
          "hint": "Only if you have final copy ready or rough points.",
          "required": false
        }
      ]
    },
    {
      "name": "Design Requirements",
      "questions": [
        {
          "code": "SP10",
          "kind": "checkbox",
          "question": "Is there anything that must appear?",
          "hint": "Select all that apply.",
          "options": [
            { "label": "Product Name", "value": "product_name" },
            { "label": "Product Price", "value": "product_price" },
            { "label": "Discount", "value": "discount" },
            { "label": "Logo", "value": "logo" },
            { "label": "Website", "value": "website" },
            { "label": "QR Code", "value": "qr_code" },
            { "label": "Promo Code", "value": "promo_code" },
            { "label": "Social Media Handle", "value": "social_media_handle" },
            { "label": "Product Rating", "value": "product_rating" },
            { "label": "Other", "value": "other" }
